{
  "name": "minds",
  "private": true,
  "version": "0.1.1",
  "description": "Minds \u2014 personal AI bots that live on your PC. Desktop GUI, CLI, and mobile remote.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "daemon": "node packages/core/bin/mindsd.js",
    "cli": "node packages/cli/bin/minds.js",
    "ui:build": "npm run build -w @bananamind/minds-ui",
    "desktop": "npm run ui:build && npm run start -w @bananamind/minds-desktop",
    "desktop:win": "npm run ui:build && node scripts/desktop-package.mjs",
    "desktop:mac": "npm run ui:build && node scripts/desktop-package.mjs --mac",
    "desktop:linux": "npm run ui:build && node scripts/desktop-package.mjs --linux",
    "test": "node --test \"packages/core/test/*.test.mjs\" \"packages/p2p/test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "cross-spawn": "^7.0.6",
    "electron-builder": "^26.15.3"
  }
}
